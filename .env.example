# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Security Configuration
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=your_secure_password_here

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
LANGCHAIN4J_LOG_LEVEL=WARN

# Chat Configuration
CHAT_MEMORY_MAX_MESSAGES=50
CHAT_MEMORY_STORE_PATH=./data/chat-memory.db
RATE_LIMIT_RPM=60

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Portfolio API Configuration
PORTFOLIO_API_BASE_URL=http://localhost:8081
PORTFOLIO_API_KEY=your_portfolio_api_key_here
PORTFOLIO_API_TIMEOUT=30s
PORTFOLIO_API_RETRY=3